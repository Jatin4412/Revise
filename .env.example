# Primary role: actual task generation. Free-tier default: Gemini 3.7 Flash.
REVISE_PRIMARY_PROVIDER=gemini
REVISE_PRIMARY_MODEL=gemini-3.7-flash

# Secondary role: independent evaluator/critic. Free-tier default: Gemini 3.1 Flash-Lite.
REVISE_SECONDARY_PROVIDER=gemini
REVISE_SECONDARY_MODEL=gemini-3.1-flash-lite

# Provider credentials
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Optional provider defaults / aliases
GEMINI_MODEL=
GEMINI_PRIMARY_MODEL=
GEMINI_SECONDARY_MODEL=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_PRIMARY_MODEL=
GROQ_SECONDARY_MODEL=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_SECONDARY_MODEL=
OPENAI_MODEL=
XAI_MODEL=

# Ollama is intentionally not part of the current testing setup.
