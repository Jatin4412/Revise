# Primary role: choose the model that does the actual task. Prefer the strongest appropriate model.
REVISE_PRIMARY_PROVIDER=gemini
REVISE_PRIMARY_MODEL=

# Secondary role: independent evaluator/critic. Usually choose a cheaper/faster model.
REVISE_SECONDARY_PROVIDER=gemini
REVISE_SECONDARY_MODEL=

# Provider credentials
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Optional provider defaults / compatibility aliases
GEMINI_MODEL=
OPENAI_MODEL=
XAI_MODEL=
OLLAMA_MODEL=
OLLAMA_ENDPOINT=http://localhost:11434
