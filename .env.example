# Primary role: actual task generation. Default is a Gemini model with a current API free tier.
REVISE_PRIMARY_PROVIDER=gemini
REVISE_PRIMARY_MODEL=gemini-3.7-flash

# Secondary role: independent evaluator/critic. Default is a smaller Gemini model with a current API free tier.
REVISE_SECONDARY_PROVIDER=gemini
REVISE_SECONDARY_MODEL=gemini-3.1-flash-lite

# Provider credentials
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Optional provider defaults / aliases
GEMINI_MODEL=
GEMINI_PRIMARY_MODEL=
GEMINI_SECONDARY_MODEL=
OPENAI_MODEL=
XAI_MODEL=
OLLAMA_PRIMARY_MODEL=gemma4:e4b
OLLAMA_SECONDARY_MODEL=qwen3:4b
OLLAMA_MODEL=
OLLAMA_ENDPOINT=http://localhost:11434
