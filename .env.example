# Primary role: actual task generation. Prefer the strongest appropriate model.
REVISE_PRIMARY_PROVIDER=gemini
REVISE_PRIMARY_MODEL=gemini-3.8-flash

# Secondary role: independent evaluator/critic. Prefer a faster/cheaper model.
REVISE_SECONDARY_PROVIDER=gemini
REVISE_SECONDARY_MODEL=gemini-3.5-flash-lite

# Provider credentials
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Optional provider defaults / aliases
GEMINI_MODEL=
OPENAI_MODEL=
XAI_MODEL=
OLLAMA_PRIMARY_MODEL=
OLLAMA_SECONDARY_MODEL=
OLLAMA_MODEL=
OLLAMA_ENDPOINT=http://localhost:11434
